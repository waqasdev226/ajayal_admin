# Lightweight image to run: php artisan serve
FROM php:8.2-cli

RUN apt-get update && apt-get install -y \
    git unzip libzip-dev libpng-dev libonig-dev libxml2-dev \
    && docker-php-ext-install pdo pdo_mysql zip bcmath \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Default: run Laravel dev server (override in docker-compose if needed)
CMD ["sh", "-c", "composer install --no-interaction --ignore-platform-reqs && php artisan serve --host=0.0.0.0 --port=8000"]

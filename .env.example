APP_NAME="Ajayal Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.ajayal.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

BROADCAST_DRIVER=log
